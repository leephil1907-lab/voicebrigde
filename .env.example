# API
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081
MAX_AUDIO_BYTES=20971520
FFMPEG_PATH=ffmpeg

# ElevenLabs: Dubbing v2 audio-to-audio translation
ELEVENLABS_API_KEY=
# Dubbing v2 cloning strength is currently set in the API request (0–10).

# Supabase (server-side only; never expose service role keys in the mobile app)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Messaging providers (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
TELEGRAM_BOT_TOKEN=

# Background jobs (optional until worker milestone)
REDIS_URL=
