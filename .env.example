# API
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081
MAX_AUDIO_BYTES=20971520

# OpenAI: audio transcription + translation
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# ElevenLabs: voice cloning + multilingual speech generation
# The account must have access to voice cloning; user must own or be authorized to clone the voice.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Supabase (server-side only; never expose service role keys in the mobile app)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Messaging providers (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=

# Background jobs (optional until worker milestone)
REDIS_URL=
