# API
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8081,http://localhost:3000
MAX_AUDIO_BYTES=20971520
MAX_AUDIO_SECONDS=120
MAX_TRANSLATIONS_PER_USER_PER_DAY=100
FFMPEG_PATH=ffmpeg
# Optional: defaults to apps/web/dist relative to the compiled API server.
# WEB_DIST_PATH=/app/web-dist

# ElevenLabs: Dubbing v2 audio-to-audio translation
ELEVENLABS_API_KEY=
# Dubbing v2 cloning strength is currently set in the API request (0–10).

# Supabase (server-side only; never expose service role keys in the mobile app)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=voicebridge-private

# Messaging providers (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=
TELEGRAM_BOT_TOKEN=

# Background worker
# Render starts the API and worker together with npm run start:render.
# The Blueprint runs one paid Pro web service; splitting the worker would add a separate billable service.
# Required for native sends; comma-separated approved Supabase user IDs.
# Never expose this or provider tokens as VITE_ variables.
VOICEBRIDGE_ALLOWED_USER_IDS=

# Paystack billing (Nigeria / NGN)
# Keep secret keys server-side. Use matching test keys and test plan codes while validating.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=NGN
PAYSTACK_APP_URL=https://voicebridge-81xs.onrender.com
# Server-owned catalog; amountMinor is in kobo. 60 credits = one billable minute.
PAYSTACK_CREDIT_PACKAGES_JSON=[{"code":"starter","name":"Starter","description":"1 translation minute · one-time top-up","amountMinor":750000,"credits":60},{"code":"growth","name":"Growth","description":"5 translation minutes · one-time top-up","amountMinor":3500000,"credits":300},{"code":"power","name":"Power","description":"10 translation minutes · one-time top-up","amountMinor":6500000,"credits":600}]
# Create these monthly plans in Paystack first, then replace the placeholder plan codes.
PAYSTACK_SUBSCRIPTION_PLANS_JSON=[{"code":"creator","name":"Creator","description":"3 translation minutes each month","paystackPlanCode":"PLN_CREATOR","amountMinor":1990000,"interval":"month","includedMinutes":3},{"code":"pro","name":"Pro","description":"8 translation minutes each month","paystackPlanCode":"PLN_PRO","amountMinor":4990000,"interval":"month","includedMinutes":8},{"code":"business","name":"Studio","description":"18 translation minutes each month","paystackPlanCode":"PLN_STUDIO","amountMinor":9990000,"interval":"month","includedMinutes":18}]
