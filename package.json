{
  "name": "voicebridge-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @voicebridge/api",
    "dev:mobile": "npm run start --workspace @voicebridge/mobile",
    "typecheck:api": "npm run typecheck --workspace @voicebridge/api",
    "typecheck:mobile": "npm run typecheck --workspace @voicebridge/mobile"
  },
  "engines": {
    "node": ">=20"
  }
}
