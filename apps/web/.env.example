# Optional: leave blank when the Fastify API serves the website (recommended).
# For a separately hosted frontend, use the HTTPS URL of your Fastify API.
VITE_API_URL=

# Development only: when set, Vite proxies /config, /health and /v1 to this API.
# This is a server-side dev proxy, not a browser-facing localhost URL.
API_PROXY_TARGET=http://127.0.0.1:8080

# Browser configuration is served by the API's GET /config endpoint.
# In API-only preview mode, Vite can read these PUBLIC values from the root .env:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Never add a Supabase secret or an ElevenLabs key to a VITE_ variable.
