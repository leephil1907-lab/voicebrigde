{
  "id": "/",
  "name": "VoiceBridge AI",
  "short_name": "VoiceBridge",
  "description": "Translate voice messages while keeping your recognizable voice, tone and expression.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f8f6",
  "theme_color": "#193b32",
  "categories": ["productivity", "communication", "utilities"],
  "icons": [
    { "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", ".mp3", ".wav", ".m4a", ".ogg", ".opus", ".webm"]
        }
      ]
    }
  }
}
