# Use your deployed HTTPS API URL, or your development computer's LAN IP.
# Do not use localhost/127.0.0.1 on a physical Android phone.
EXPO_PUBLIC_API_URL=https://YOUR-VOICEBRIDGE-API-DOMAIN

# Supabase client configuration (publishable key only; never put service-role key here)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
